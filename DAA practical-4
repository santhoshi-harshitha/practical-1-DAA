      "cell_type": "code",
      "source": [
        "def factorial(n):\n",
        "    if n == 0 or n == 1:\n",
        "        return 1\n",
        "    return n * factorial(n - 1)\n",
        "\n",
        "n = int(input(\"Enter a number: \"))\n",
        "\n",
        "result = factorial(n)\n",
        "\n",
        "print(\"Factorial using Recursion:\", result)"
      ],
